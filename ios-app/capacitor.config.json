{
  "appId": "app.ordela.ios",
  "appName": "Ordela",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false,
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#121F4A",
      "showSpinner": false
    },
    "LocalNotifications": {
      "presentationOptions": [
        "banner",
        "sound",
        "list"
      ]
    }
  }
}
